{
  "name": "QuizLead",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email do lead (se informado)"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp do lead (se informado)"
    },
    "recommended_product": {
      "type": "string",
      "enum": [
        "serum",
        "simbiotico",
        "box"
      ],
      "description": "Produto recomendado com base nas respostas"
    },
    "score_serum": {
      "type": "number",
      "description": "Score do S\u00e9rum"
    },
    "score_simbiotico": {
      "type": "number",
      "description": "Score do Simbi\u00f3tico"
    },
    "score_box": {
      "type": "number",
      "description": "Score do Box"
    },
    "answers": {
      "type": "string",
      "description": "Respostas do quiz em JSON"
    }
  },
  "required": [
    "recommended_product"
  ]
}