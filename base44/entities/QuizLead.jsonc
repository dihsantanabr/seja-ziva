{
  "name": "QuizLead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do lead"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email do lead"
    },
    "objective": {
      "type": "string",
      "enum": [
        "aparencia",
        "firmeza",
        "forca",
        "multiplo"
      ],
      "description": "Objetivo principal selecionado no quiz"
    },
    "symptom": {
      "type": "string",
      "description": "Sintoma ou contexto selecionado"
    },
    "routine": {
      "type": "string",
      "description": "Tipo de rotina selecionada"
    },
    "recommendedProduct": {
      "type": "string",
      "enum": [
        "colageno",
        "lift",
        "creatina"
      ],
      "description": "Produto recomendado com base nas respostas"
    }
  },
  "required": [
    "name",
    "email",
    "objective",
    "symptom",
    "routine",
    "recommendedProduct"
  ]
}